# ==============================================================================
# GuacamoleGH Landing - Variables de Entorno de Ejemplo
# ==============================================================================
# Copia este archivo como .env si deseas personalizar puertos o URLs públicas:
#   cp .env.example .env
#
# NOTA: No incluyas tokens privados ni contraseñas.
# Las variables que empiezan por VITE_ son públicas y se empaquetan en el frontend.

# Puerto en el servidor host para Docker Compose
PORT=3080

# Enlace al perfil de GitHub
VITE_GITHUB_URL=https://github.com/GuacamoleGH

# URLs públicas de los servicios del Homelab
VITE_HUB_URL=https://hub.guacamolegh.es
VITE_ATLAS_URL=https://atlas.guacamolegh.es
VITE_COCHE_URL=https://coche.guacamolegh.es

# URL del panel de Uptime Kuma
VITE_UPTIME_KUMA_URL=https://kuma.guacamolegh.es
